TZ=Europe/Berlin

# With Network=host Grafana would otherwise listen on all interfaces;
# bind to localhost only — Caddy proxies to localhost:3000
GF_SERVER_HTTP_ADDR=127.0.0.1

# Disable usage stats collection (prevents noise from missing plugins like grafana-amazonprometheus-datasource)
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false

